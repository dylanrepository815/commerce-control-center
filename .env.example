# Copy to .env and set two different randomly generated alphanumeric passwords.
POSTGRES_PASSWORD=REPLACE_WITH_RANDOM_ADMIN_PASSWORD
APP_DB_PASSWORD=REPLACE_WITH_RANDOM_APP_PASSWORD
APP_ORIGIN=http://localhost:3000
WEB_PORT=3000
COOKIE_SECURE=false
# Explicitly enables synthetic .example data. Disable for real deployments.
ENABLE_FIXTURES=true
